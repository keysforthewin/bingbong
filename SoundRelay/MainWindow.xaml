<Window x:Class="SoundRelay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Relay"
        Width="680" Height="740"
        MinWidth="520" MinHeight="600"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- ScrollViewer dark theme -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />    <!-- Header -->
            <RowDefinition Height="Auto" />    <!-- Connection -->
            <RowDefinition Height="Auto" />    <!-- Audio Device -->
            <RowDefinition Height="*" />       <!-- Sound Mappings -->
            <RowDefinition Height="Auto" />    <!-- Log -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🔊 Sound Relay"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="WebSocket-triggered audio player"
                       Foreground="{StaticResource TextDimBrush}"
                       FontSize="13" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Connection Section -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource ErrorBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText" Text="Disconnected"
                                   Foreground="{StaticResource TextDimBrush}" FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                        <CheckBox x:Name="chkLaunchAtStartup" Content="Launch at startup"
                                  Foreground="{StaticResource TextDimBrush}" FontSize="12"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  Checked="ChkLaunchAtStartup_Changed"
                                  Unchecked="ChkLaunchAtStartup_Changed" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="WebSocket URL" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <TextBox x:Name="txtWebSocketUrl"
                                 Style="{StaticResource DarkTextBox}"
                                 Text="ws://localhost:8080" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="PIN" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <TextBox x:Name="txtPin"
                                 Style="{StaticResource DarkTextBox}"
                                 Width="70" MaxLength="4"
                                 ToolTip="4-digit PIN for server authentication" />
                    </StackPanel>

                    <Button x:Name="btnConnect" Grid.Column="2"
                            Content="Connect"
                            Style="{StaticResource AccentButton}"
                            Click="BtnConnect_Click"
                            MinWidth="100"
                            VerticalAlignment="Bottom" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Audio Device Section -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Audio Output Device" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="cboAudioDevice"
                              Style="{StaticResource DarkComboBox}"
                              Margin="0,0,8,0"
                              SelectionChanged="CboAudioDevice_SelectionChanged" />

                    <Button Grid.Column="1" Content="🔄 Refresh"
                            Style="{StaticResource SubtleButton}"
                            Click="BtnRefreshDevices_Click"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="2" Content="🔊 Test"
                            Style="{StaticResource SubtleButton}"
                            Click="BtnTestAudio_Click" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Volume" Foreground="{StaticResource TextDimBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider x:Name="sldVolume" Width="200" Minimum="0" Maximum="100" Value="100"
                            VerticalAlignment="Center"
                            ValueChanged="SldVolume_ValueChanged" />
                    <TextBlock x:Name="txtVolumeLabel" Text="100%"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Sound Mappings Section -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Sound Mappings"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="WebSocket message → audio file"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Add new mapping -->
                <Border Grid.Row="1" Background="{StaticResource BgBrush}"
                        CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Trigger Name" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="txtNewName"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="160"
                                     ToolTip="The name that triggers this sound (e.g., 'bing bong')" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Audio File" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtNewFilePath"
                                         Style="{StaticResource DarkTextBox}"
                                         IsReadOnly="True"
                                         Margin="0,0,6,0" />
                                <Button Grid.Column="1" Content="Browse"
                                        Style="{StaticResource SubtleButton}"
                                        Click="BtnBrowseFile_Click"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                        </StackPanel>

                        <Button Grid.Column="2" Content="＋ Add"
                                Style="{StaticResource AccentButton}"
                                Click="BtnAddMapping_Click"
                                VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <!-- Mappings list -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="lstMappings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgBrush}"
                                        CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#33FFFFFF"
                                                CornerRadius="4" Padding="8,4" Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                       FontSize="13" FontWeight="SemiBold" />
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FilePath}"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FilePath}" />

                                        <Button Grid.Column="2" Content="▶ Play"
                                                Style="{StaticResource SubtleButton}"
                                                Tag="{Binding Name}"
                                                Click="BtnPlayMapping_Click"
                                                Margin="8,0,4,0"
                                                VerticalAlignment="Center" />

                                        <Button Grid.Column="3" Content="✕ Remove"
                                                Style="{StaticResource DangerButton}"
                                                Tag="{Binding Name}"
                                                Click="BtnRemoveMapping_Click"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Log Section -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}"
                CornerRadius="10" Padding="12" Height="140">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Activity Log"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="12" VerticalAlignment="Center" />
                    <Button Content="Clear"
                            Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Right"
                            Click="BtnClearLog_Click" />
                </Grid>

                <TextBox x:Name="txtLog" Grid.Row="1"
                         Background="{StaticResource BgBrush}"
                         Foreground="{StaticResource TextDimBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         FontFamily="Consolas" FontSize="11"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8" />
            </Grid>
        </Border>
    </Grid>
</Window>
